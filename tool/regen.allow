# Files generated by p0g_app that the demo changes on purpose, one per line,
# each with the reason. Keep this short; ask bricks for a hook instead.
README.md                      # the demo's own README
app/lib/main.dart              # main() opens the demo's pages (bricks: add a pages hook)
core/pubspec.yaml              # squadron_process git dep (process_place variant not wired yet)
cli/pubspec.yaml               # squadron_process git dep, for serve
core/lib/demo_core.dart        # exports at the p0g:exports marker
cli/lib/src/runner.dart        # commands at the p0g:commands marker
